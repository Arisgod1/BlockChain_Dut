---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { dateText, labels, paths } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('generated');
  return entries.filter((entry) => entry.data.status !== 'draft').map((entry) => ({ params: { section: paths[entry.data.type], id: entry.data.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<BaseLayout title={`${entry.data.title}｜区块链组知识库`} description={entry.data.summary}>
  <article class="article-shell" data-pagefind-body>
    <header class="article-header">
      <div class="article-meta"><span>{labels[entry.data.type]}</span><time datetime={entry.data.updatedAt.toISOString()}>更新于 {dateText(entry.data.updatedAt)}</time>{entry.data.status === 'archived' && <span class="status archived">已归档</span>}</div>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1><p>{entry.data.summary}</p>
      <div class="tag-row">{entry.data.tags.map((tag) => <span>{tag}</span>)}</div>
    </header>
    <div class="article-grid">
      <aside aria-label="本文目录"><strong>本文目录</strong>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
</BaseLayout>
