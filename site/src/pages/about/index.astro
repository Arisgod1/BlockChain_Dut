---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { publicEntries, withBase } from '../../lib/content';
const entries = await publicEntries();
const group = entries.filter((entry) => ['group', 'recruitment'].includes(entry.data.type));
const recruitment = entries.find((entry) => entry.data.type === 'recruitment');
const qqQr = recruitment?.data.type === 'recruitment'
  ? recruitment.data.media.find((item) => item.path === '/assets/site/contact/qq-group-qr.png')
  : undefined;
---
<BaseLayout title="组内动态｜区块链组知识库">
  <section class="about-hero content-shell">
    <div><p class="system-label">GROUP PULSE</p><h1>组内动态</h1><p>在这里看我们的近况～</p></div>
    <img src={withBase('generated/assets/site/blockchain-group-sign.png')} alt="区块链组招牌" width="500" height="500" />
  </section>
  <section class="content-shell about-grid">
    <div><h2>网站维护方式</h2><p>成员通过 Pull Request 提交统一格式的文档和图片。</p>
    <p>采用skil统一发布</p></div>
    <div>
      <h2>如何加入</h2>
      {recruitment?.data.type === 'recruitment' && qqQr ? (
        <div class="join-contact">
          <figure>
            <img class="qq-group-qr" src={withBase(`generated${qqQr.path}`)} alt={qqQr.alt} width="1000" height="1000" />
            <figcaption>QQ群：{recruitment.data.qqGroupNumber}</figcaption>
          </figure>
          <div class="contact-details">
            <p>扫码申请加入交流群，或通过邮箱联系我们。</p>
            <a href={`mailto:${recruitment.data.contactEmail}`}>{recruitment.data.contactEmail}</a>
          </div>
        </div>
      ) : <p>公开联系方式将在确认后通过正式文档发布。</p>}
    </div>
  </section>
  <section class="content-shell collection-panel"><div class="section-heading"><h2>动态与公开说明</h2></div><EntryList entries={group} empty="加入信息确认后会通过正式文档发布。" /></section>
</BaseLayout>
