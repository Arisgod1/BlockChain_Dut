---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageIntro from '../../components/PageIntro.astro'; import EntryList from '../../components/EntryList.astro'; import { publicEntries } from '../../lib/content';
const entries=(await publicEntries()).filter(e=>e.data.type==='track');
---
<BaseLayout title="技术指导｜区块链组知识库"><PageIntro code="KNOWLEDGE PATHS" title="技术指导" description="按方向组织知识地图、推荐路径、实践项目和相关例会。" /><section class="content-shell section-block"><EntryList entries={entries} empty="尚无已发布的技术方向；格式模板已经准备好。" /></section></BaseLayout>
