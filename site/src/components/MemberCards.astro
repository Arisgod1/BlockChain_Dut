---
import type { KnowledgeEntry } from '../lib/content';
import { entryPath } from '../lib/content';
const { entries } = Astro.props as { entries: KnowledgeEntry[] };
---
<ol class="member-grid">
  {entries.map((entry) => entry.data.type === 'member' && (() => {
    const sourceRole = entry.data.tags.find((tag) => ['组长', '老师', '成员'].includes(tag)) ?? '成员';
    const role = sourceRole === '成员' ? '组员' : sourceRole;
    const technicalTags = entry.data.tags.filter((tag) => !['组长', '老师', '成员'].includes(tag));
    return <li data-filter-item data-role={role} data-tags={technicalTags.join('|')} data-year={entry.data.grade} data-search-text={`${entry.data.title} ${entry.data.summary} ${technicalTags.join(' ')}`}>
      <a class="member-card" href={entryPath(entry)} aria-label={`查看${entry.data.title}的成员资料`}>
        <span class="member-card-inner">
          <span class="member-card-face member-card-front">
            <img class="member-avatar" src={entry.data.avatarUrl} alt="" width="96" height="96" loading="lazy" referrerpolicy="no-referrer" />
            <span class={`member-role role-${role}`}>{role}</span>
            <strong>{entry.data.title}</strong>
            <span class="member-grade">{entry.data.grade} 级</span>
            <span class="member-tags">{technicalTags.slice(0, 3).join(' · ') || '公开成员资料'}</span>
            <small>悬停查看简介</small>
          </span>
          <span class="member-card-face member-card-back">
            <strong>个人简介</strong>
            <span>{entry.data.summary}</span>
            <span class="member-contact">{entry.data.contacts[0] ? `${entry.data.contacts[0].label} · ${entry.data.contacts[0].value}` : '联系方式暂未公开'}</span>
            <small>点击进入详情 →</small>
          </span>
        </span>
      </a>
    </li>;
  })())}
</ol>
