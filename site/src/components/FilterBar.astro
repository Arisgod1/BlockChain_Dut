---
const { tags = [], roles = [], years = [], gradeLabel = '时间', searchable = false, searchLabel = '搜索', searchPlaceholder = '搜索标题、摘要或标签', sortable = false } = Astro.props as { tags?: string[]; roles?: string[]; years?: string[]; gradeLabel?: string; searchable?: boolean; searchLabel?: string; searchPlaceholder?: string; sortable?: boolean };
---
<div class="content-filter" data-filter-root>
  {searchable && <label class="filter-search"><span>{searchLabel}</span><input type="search" data-query placeholder={searchPlaceholder} autocomplete="off" /></label>}
  {roles.length > 0 && <div class="filter-group identity-filter" role="group" aria-label="身份筛选（可多选）">
    <span>身份</span>
    <button type="button" class="is-active" data-filter-kind="role" data-value="all" aria-pressed="true">全部</button>
    {roles.map((role) => <button type="button" class={`role-${role}`} data-filter-kind="role" data-value={role} aria-pressed="false">{role}</button>)}
  </div>}
  {tags.length > 0 && <div class="filter-group" role="group" aria-label="技术标签筛选（可多选）">
    <span>技术标签</span>
    <button type="button" class="is-active" data-filter-kind="tag" data-value="all" aria-pressed="true">全部</button>
    {tags.map((tag) => <button type="button" data-filter-kind="tag" data-value={tag} aria-pressed="false">{tag}</button>)}
  </div>}
  <div class="filter-options">
    {years.length > 0 && <label class="filter-select"><span>{gradeLabel}</span><select data-year><option value="all">全部</option>{years.map((year) => <option value={year}>{year}{gradeLabel === '入学时间' ? '级' : '年'}</option>)}</select></label>}
    {sortable && <label class="filter-select"><span>时间排序</span><select data-sort><option value="desc">由新到旧</option><option value="asc">由旧到新</option></select></label>}
  </div>
  <output data-filter-count aria-live="polite"></output>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-filter-root]').forEach((root) => {
    const scope = root.closest<HTMLElement>('[data-filter-scope]');
    if (!scope) return;
    const list = scope.querySelector<HTMLElement>('.entry-list, .member-grid');
    const items = [...scope.querySelectorAll<HTMLElement>('[data-filter-item]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter-kind]')];
    const yearSelect = root.querySelector<HTMLSelectElement>('[data-year]');
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort]');
    const queryInput = root.querySelector<HTMLInputElement>('[data-query]');
    const output = root.querySelector<HTMLOutputElement>('[data-filter-count]');
    const selectedTags = new Set<string>();
    const selectedRoles = new Set<string>();

    const syncButtons = (kind: string, selected: Set<string>) => {
      buttons.filter((button) => button.dataset.filterKind === kind).forEach((button) => {
        const value = button.dataset.value ?? 'all';
        const active = value === 'all' ? selected.size === 0 : selected.has(value);
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };

    const update = () => {
      const year = yearSelect?.value ?? 'all';
      const query = queryInput?.value.trim().toLocaleLowerCase('zh-CN') ?? '';
      let visible = 0;
      items.forEach((item) => {
        const itemTags = (item.dataset.tags ?? '').split('|').filter(Boolean);
        const searchText = (item.dataset.searchText ?? item.textContent ?? '').toLocaleLowerCase('zh-CN');
        const tagMatch = selectedTags.size === 0 || [...selectedTags].some((tag) => itemTags.includes(tag));
        const roleMatch = selectedRoles.size === 0 || selectedRoles.has(item.dataset.role ?? '');
        const match = tagMatch && roleMatch && (year === 'all' || item.dataset.year === year) && (!query || searchText.includes(query));
        item.hidden = !match;
        if (match) visible += 1;
      });
      if (sortSelect && list) {
        const direction = sortSelect.value === 'asc' ? 1 : -1;
        [...items].sort((a, b) => direction * (Number(a.dataset.timestamp ?? 0) - Number(b.dataset.timestamp ?? 0))).forEach((item) => list.append(item));
      }
      if (output) output.textContent = `${visible} 项`;
    };

    buttons.forEach((button) => button.addEventListener('click', () => {
      const kind = button.dataset.filterKind ?? '';
      const value = button.dataset.value ?? 'all';
      const selected = kind === 'role' ? selectedRoles : selectedTags;
      if (value === 'all') selected.clear();
      else if (selected.has(value)) selected.delete(value);
      else selected.add(value);
      syncButtons(kind, selected);
      update();
    }));
    yearSelect?.addEventListener('change', update);
    sortSelect?.addEventListener('change', update);
    queryInput?.addEventListener('input', update);
    update();
  });
</script>
